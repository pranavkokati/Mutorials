<%# Study coach, rendered inside layouts/app.ejs. ARGUMENTS: coach - { subjects, attemptsAnalysed, reviewDue, truncated } %>
<%
  const clean = (u) => u.replace(/^[^-]*- /, '');
  const statusBadge = {
    weak: ['badge-bad', 'Weak spot'],
    strong: ['badge-good', 'Strength'],
    'on-track': ['', 'On track'],
  };
  const names = Object.keys(coach.subjects);
%>

<h1 class="page-title">Study Coach</h1>
<p class="page-lead">Where you outperform or underperform your own rating, by unit.</p>

<% if (coach.reviewDue > 0) { %>
<div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-200">
  <span><strong><%= coach.reviewDue %></strong> missed question<%= coach.reviewDue === 1 ? ' is' : 's are' %> due for spaced review.</span>
  <a class="btn btn-primary" href="/review">Start review</a>
</div>
<% } %>

<% if (names.length === 0) { %>
<div class="card card-pad mt-8 text-center muted">Set an initial rating in at least one subject and answer some questions to see coaching.</div>
<% } %>

<% names.forEach((name) => { const s = coach.subjects[name]; %>
<section class="card card-pad mt-8" aria-labelledby="sub-<%= name %>">
  <div class="flex items-baseline justify-between">
    <h2 id="sub-<%= name %>" class="text-2xl font-bold"><%= name %></h2>
    <span class="badge badge-info">Rating <%= s.rating %></span>
  </div>

  <% if (s.recommendations.length > 0) { %>
  <h3 class="mt-4 text-sm font-semibold uppercase tracking-wide muted">Suggested next</h3>
  <ul class="mt-2 grid gap-2 sm:grid-cols-2">
    <% s.recommendations.forEach((r) => { %>
    <li>
      <a class="card-link flex items-center justify-between gap-3 px-4 py-3" href="<%= r.href %>">
        <span class="font-medium"><%= clean(r.unit) %></span>
        <% if (r.reason === 'weak') { %>
          <span class="badge badge-bad"><%= (r.residual * 100).toFixed(0) %> pts</span>
        <% } else { %>
          <span class="badge">New</span>
        <% } %>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <% if (s.units.length > 0) { %>
  <div class="mt-5 overflow-x-auto">
    <table class="w-full text-left text-sm">
      <caption class="sr-only"><%= name %> unit performance against rating expectation</caption>
      <thead class="border-b border-neutral-200 text-xs uppercase tracking-wide muted dark:border-neutral-800">
        <tr>
          <th scope="col" class="py-2 pr-4">Unit</th>
          <th scope="col" class="px-2 text-right">Attempts</th>
          <th scope="col" class="px-2 text-right">Accuracy</th>
          <th scope="col" class="px-2 text-right">Expected</th>
          <th scope="col" class="px-2 text-right">vs expected</th>
          <th scope="col" class="pl-4">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
        <% s.units.forEach((u) => { const b = statusBadge[u.status]; %>
        <tr>
          <th scope="row" class="py-2 pr-4 font-medium"><%= clean(u.unit) %></th>
          <td class="px-2 text-right tabular-nums"><%= u.attempts %></td>
          <td class="px-2 text-right tabular-nums"><%= Math.round(u.accuracy * 100) %>%</td>
          <td class="px-2 text-right tabular-nums"><%= Math.round(u.expectedAccuracy * 100) %>%</td>
          <td class="px-2 text-right tabular-nums"><%= (u.residual >= 0 ? '+' : '') + (u.residual * 100).toFixed(1) %> pts</td>
          <td class="pl-4">
            <% if (b) { %><span class="badge <%= b[0] %>"><%= b[1] %></span>
            <% } else { %><span class="badge">Need more data</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="mt-4 text-sm muted">No rated answers in this subject yet.</p>
  <% } %>
</section>
<% }) %>

<p class="mt-8 text-sm muted">
  Based on your last <%= coach.attemptsAnalysed %> rated answers<%= coach.truncated ? ' (older history is not included)' : '' %>.
  "vs expected" compares your results with what your rating predicted for those questions, so it is relative to your
  own overall level in the subject, with recent answers weighted more. Units with few answers are shrunk towards
  "on track" and are not classified until there is enough evidence. See docs/COACH.md.
</p>
