<%# Study coach, rendered inside layouts/app.ejs. ARGUMENTS: coach - { subjects, attemptsAnalysed, reviewDue, truncated } %>
<%
  const clean = (u) => u.replace(/^[^-]*- /, '');
  const names = Object.keys(coach.subjects);
  const pts = (x) => (x >= 0 ? '+' : '−') + Math.abs(x * 100).toFixed(1);
%>

<h1 class="page-title">Study coach</h1>
<p class="page-lead">For each unit, how your results compare with what your rating predicts.</p>

<% if (coach.reviewDue > 0) { %>
<p class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2">
  <span><span class="mark"><%= coach.reviewDue %></span> missed question<%= coach.reviewDue === 1 ? ' is' : 's are' %> due for review.</span>
  <a class="link" href="/review">Start review</a>
</p>
<% } %>

<% if (names.length === 0) { %>
<p class="mt-10 max-w-prose muted">Set a starting rating in at least one subject and answer some questions. The coach needs a few answers per unit before it says anything.</p>
<% } %>

<% names.forEach((name) => { const s = coach.subjects[name]; %>
<section class="mt-14 border-t border-rule pt-8" aria-labelledby="sub-<%= name %>">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="sub-<%= name %>" class="text-2xl font-semibold tracking-tight"><%= name %></h2>
    <p class="text-muted">Rating <span class="font-semibold text-ink tabular-nums"><%= s.rating %></span></p>
  </div>

  <% if (s.recommendations.length > 0) { %>
  <h3 class="mt-6 font-semibold">Practise next</h3>
  <ul class="rows mt-2">
    <% s.recommendations.forEach((r) => { %>
    <li>
      <a class="row-link flex items-baseline justify-between gap-4" href="<%= r.href %>">
        <span class="font-medium"><%= clean(r.unit) %></span>
        <span class="text-sm <%= r.reason === 'weak' ? 'pen-weak' : 'muted' %>">
          <%= r.reason === 'weak' ? (r.residual * 100).toFixed(0) + ' points below expected' : 'Not practised yet' %>
        </span>
      </a>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <% if (s.units.length > 0) { %>
  <div class="mt-8 overflow-x-auto">
    <table class="plain w-full min-w-[34rem] text-left text-sm">
      <caption class="sr-only"><%= name %> unit results against rating expectation</caption>
      <thead class="text-muted">
        <tr class="border-b border-rule">
          <th scope="col" class="py-2 pr-4 font-medium">Unit</th>
          <th scope="col" class="px-2 py-2 text-right font-medium">Answers</th>
          <th scope="col" class="px-2 py-2 text-right font-medium">Correct</th>
          <th scope="col" class="px-2 py-2 text-right font-medium">Expected</th>
          <th scope="col" class="px-2 py-2 text-right font-medium">Difference</th>
          <th scope="col" class="py-2 pl-5 font-medium">Verdict</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule">
        <% s.units.forEach((u) => { %>
        <tr>
          <th scope="row" class="py-3 pr-4 font-medium"><%= clean(u.unit) %></th>
          <td class="px-2 py-3 text-right tabular-nums"><%= u.attempts %></td>
          <td class="px-2 py-3 text-right tabular-nums"><%= Math.round(u.accuracy * 100) %>%</td>
          <td class="px-2 py-3 text-right tabular-nums"><%= Math.round(u.expectedAccuracy * 100) %>%</td>
          <td class="px-2 py-3 text-right tabular-nums"><%= pts(u.residual) %> points</td>
          <td class="py-3 pl-5">
            <% if (u.status === 'weak') { %><span class="pen-weak font-medium">Weak spot</span>
            <% } else if (u.status === 'strong') { %><span class="pencil-good font-medium">Strength</span>
            <% } else if (u.status === 'on-track') { %><span class="muted">On track</span>
            <% } else { %><span class="muted">Needs more answers</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="mt-6 text-sm muted">No rated answers in this subject yet.</p>
  <% } %>
</section>
<% }) %>

<p class="mt-14 max-w-prose border-t border-rule pt-6 text-sm text-muted">
  Based on your last <%= coach.attemptsAnalysed %> rated answers<%= coach.truncated ? ' (older history is not included)' : '' %>.
  "Expected" is what your rating predicted for the questions you were given, so a unit is judged against your own level, with recent answers counting more.
  Units with few answers are pulled towards "on track" and are not labelled until there is enough evidence. Method: docs/COACH.md.
</p>
