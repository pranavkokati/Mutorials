<%#
  Signed-in dashboard, rendered inside layouts/app.ejs.
  ARGUMENTS: user, experienceStats, levelPct, ratingCards, reviewDue,
             siteStats, question, announcements, admin
%>

<section aria-labelledby="welcome">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 id="welcome" class="page-title">Welcome back, <%= user.ign %></h1>
      <p class="page-lead">Pick up where you left off, or let the coach choose your next unit.</p>
    </div>
    <div class="w-full sm:w-72">
      <div class="mb-1 flex items-baseline justify-between text-sm">
        <span class="font-semibold">Level <%= experienceStats.level %></span>
        <span class="muted"><%= experienceStats.remainder %> / <%= experienceStats.totalToNext %> XP</span>
      </div>
      <div class="progress" role="progressbar" aria-label="Progress to level <%= experienceStats.level + 1 %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= levelPct %>">
        <span style="width: <%= levelPct %>%"></span>
      </div>
    </div>
  </div>
</section>

<section class="mt-8 grid gap-4 md:grid-cols-3" aria-label="Where to go next">
  <a class="card-link card-pad" href="/coach">
    <p class="text-sm font-semibold text-brand-600 dark:text-brand-200">Study Coach</p>
    <h2 class="mt-1 text-lg font-bold">Find your weak spots</h2>
    <p class="mt-1 text-sm muted">Units where you do worse than your rating predicts, with a next unit to practise.</p>
  </a>
  <a class="card-link card-pad" href="/review">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-brand-600 dark:text-brand-200">Spaced Review</p>
      <% if (reviewDue > 0) { %><span class="badge badge-warn"><%= reviewDue %> due</span><% } else { %><span class="badge badge-good">All caught up</span><% } %>
    </div>
    <h2 class="mt-1 text-lg font-bold">Revisit missed questions</h2>
    <p class="mt-1 text-sm muted">Questions you missed return on a schedule until they stick. Never changes your rating.</p>
  </a>
  <a class="card-link card-pad" href="/train">
    <p class="text-sm font-semibold text-brand-600 dark:text-brand-200">Train</p>
    <h2 class="mt-1 text-lg font-bold">Classic, Rush or Daily</h2>
    <p class="mt-1 text-sm muted">Adaptive practice by subject and unit, a timed rush, or today's challenge question.</p>
  </a>
</section>

<section class="mt-10" aria-labelledby="ratings-h">
  <div class="flex items-baseline justify-between">
    <h2 id="ratings-h" class="text-xl font-bold">Your ratings</h2>
    <a class="text-sm underline hover:no-underline" href="/stats">Full statistics</a>
  </div>
  <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% ratingCards.forEach((c) => { %>
    <li>
      <a class="card-link card-pad flex h-full flex-col" href="<%= c.href %>">
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2 font-semibold">
            <span class="inline-block h-2.5 w-2.5 rounded-full" style="background: <%= c.color %>"></span>
            <%= c.label %>
          </span>
          <% if (c.rated && c.trend) { %>
            <span class="text-xs font-medium <%= c.trend.change >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>">
              <%= c.trend.change >= 0 ? '+' : '−' %><%= Math.abs(Math.round(c.trend.change)) %>
              <span class="muted">/ last <%= c.trend.samples %></span>
            </span>
          <% } %>
        </div>
        <div class="mt-2 flex items-end justify-between gap-3">
          <% if (c.rated) { %>
            <span class="text-3xl font-bold tabular-nums"><%= c.rating %></span>
          <% } else { %>
            <span class="text-lg font-semibold muted">Not rated yet</span>
          <% } %>
          <% if (c.trend) { %>
            <svg viewBox="0 0 <%= c.trend.width %> <%= c.trend.height %>" width="<%= c.trend.width %>" height="<%= c.trend.height %>" role="img" aria-label="<%= c.label %> rating trend over <%= c.trend.samples %> answers" class="shrink-0">
              <polyline fill="none" stroke="<%= c.color %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="<%= c.trend.points %>"/>
              <circle cx="<%= c.trend.last[0] %>" cy="<%= c.trend.last[1] %>" r="3" fill="<%= c.color %>"/>
            </svg>
          <% } %>
        </div>
      </a>
    </li>
    <% }) %>
  </ul>
</section>

<% if (user.contributor) { %>
<section class="mt-10" aria-labelledby="contrib-h">
  <h2 id="contrib-h" class="text-xl font-bold">Contributor tools <span class="badge badge-info ml-2"><%= user.contributor %></span></h2>
  <div class="mt-3 flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/contributors/addQuestion">Write question</a>
    <a class="btn btn-outline" href="/contributors/addUSABOQuestion">Write USABO question</a>
    <% if (user.reviewer) { %><a class="btn btn-outline" href="/reviewer/reviewQuestions">Review questions</a><% } %>
    <a class="btn btn-outline" href="/contributors/stats">My contribution stats</a>
    <a class="btn btn-outline" href="/contributors/items">Item analysis</a>
  </div>
</section>
<% } %>

<% if (admin) { %>
<section class="mt-6">
  <a class="btn btn-outline" href="/admin/adminHomepage">Admin dashboard</a>
</section>
<% } %>

<section class="mt-10 grid gap-6 lg:grid-cols-2">
  <div class="card card-pad" aria-labelledby="daily-h">
    <h2 id="daily-h" class="text-lg font-bold">Daily question</h2>
    <p class="mt-1 text-sm muted">A new problem every day at 00:00 UTC.</p>
    <% if (question && question.question) { %>
      <div class="mt-3 line-clamp-4 text-sm"><%- question.question %></div>
    <% } %>
    <a class="btn btn-primary mt-4 w-fit" href="/train/daily">Open today's challenge</a>
  </div>

  <div class="card card-pad" aria-labelledby="news-h">
    <div class="flex items-baseline justify-between">
      <h2 id="news-h" class="text-lg font-bold">Announcements</h2>
      <a class="text-sm underline hover:no-underline" href="/announcements">All</a>
    </div>
    <% if (announcements && announcements.length) { %>
      <ul class="mt-3 divide-y divide-neutral-200 dark:divide-neutral-800">
        <% announcements.forEach((a) => { %>
          <li class="py-3 first:pt-0 last:pb-0">
            <p class="font-semibold"><%= a.title %></p>
            <p class="text-xs muted">Posted <%= String(a.date).split('T')[0] %></p>
            <div class="mt-1 text-sm"><%- a.text %></div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="mt-3 text-sm muted">No announcements yet.</p>
    <% } %>
  </div>
</section>

<section class="mt-10 grid grid-cols-3 gap-4 text-center" aria-label="Site statistics">
  <div class="card card-pad">
    <p class="text-3xl font-bold tabular-nums"><%= siteStats.questionCount %></p>
    <p class="text-sm muted">Questions</p>
  </div>
  <div class="card card-pad">
    <p class="text-3xl font-bold tabular-nums"><%= siteStats.tagCount %></p>
    <p class="text-sm muted">Unit tags</p>
  </div>
  <div class="card card-pad">
    <p class="text-3xl font-bold tabular-nums"><%= siteStats.totalSolves.physics + siteStats.totalSolves.chemistry + siteStats.totalSolves.biology %></p>
    <p class="text-sm muted">Total solves</p>
  </div>
</section>
