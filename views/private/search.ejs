<%# Search, rendered inside layouts/app.ejs. ARGUMENTS: results, semantic, query, hasQuery, subjectTags %>
<%
  const str = (v) => (typeof v === 'string' ? v : '');
  const selected = str(query.subjects).split(',').map((s) => s.trim()).filter(Boolean);
  const subjectNames = Object.keys(subjectTags || {});
  const hrefFor = (r) => r.type === 'QUESTION' ? '/train/displayQuestion/' + r.id : (r.type === 'USER' ? '/profile/' + encodeURIComponent(r.id) : '#');
  const kind = (t) => ({ QUESTION: 'Question', USER: 'Trainer' }[t] || t);
%>
<h1 class="page-title">Search</h1>
<p class="page-lead">Find questions by words or by meaning, or look up another trainer.</p>

<form class="mt-8 flex flex-col gap-3 sm:flex-row" action="/search" method="GET" role="search">
  <label class="sr-only" for="q">Search text</label>
  <input id="q" name="text" type="search" class="min-w-0 flex-1 !py-3" placeholder="spring oscillation, enzyme inhibition, a username" value="<%= str(query.text) %>" maxlength="200" autofocus>
  <label class="sr-only" for="subjects">Subject</label>
  <select id="subjects" name="subjects" class="!py-3 sm:w-52">
    <option value="">Any subject</option>
    <% subjectNames.forEach((name) => { %>
    <option value="<%= name %>" <%= selected[0] === name ? 'selected' : '' %>><%= name %></option>
    <% }) %>
  </select>
  <button class="btn btn-primary !px-6" type="submit">Search</button>
</form>

<% if (results.length > 0) { %>
  <h2 class="section-title mt-12"><%= results.length %> result<%= results.length === 1 ? '' : 's' %></h2>
  <ul class="rows mt-3">
    <% results.forEach((r) => { %>
    <li>
      <a class="row-link" href="<%= hrefFor(r) %>">
        <span class="flex items-baseline justify-between gap-4">
          <span class="font-semibold"><%= r.title %></span>
          <span class="text-sm text-muted"><%= kind(r.type) %></span>
        </span>
        <span class="paper-sm mt-1 line-clamp-2 block text-muted"><%= r.snippet || r.preview %></span>
      </a>
    </li>
    <% }) %>
  </ul>
<% } else if (hasQuery && !(semantic && semantic.length > 0)) { %>
  <p class="mt-12 max-w-prose" role="status">
    No results for <span class="font-semibold"><%= JSON.stringify(str(query.text)) %></span>. Try fewer or different words, or remove the subject filter.
  </p>
<% } %>

<% if (semantic && semantic.length > 0) { %>
  <h2 class="section-title mt-12">Related by meaning</h2>
  <p class="mt-1 max-w-prose text-sm text-muted">These questions are close in meaning to your search even when the words differ. A language model running on this server ranks them, so some may be only loosely related.</p>
  <ul class="rows mt-3">
    <% semantic.forEach((r) => { %>
    <li>
      <a class="row-link" href="/train/displayQuestion/<%= r.id %>">
        <span class="font-semibold"><%= r.title %></span>
        <span class="paper-sm mt-1 line-clamp-2 block text-muted"><%= r.snippet || r.preview %></span>
      </a>
    </li>
    <% }) %>
  </ul>
<% } %>
