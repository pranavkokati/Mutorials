<%# Daily problem, rendered inside layouts/app.ejs. Checked in the browser, so it never touches your rating. %>
<%# ARGUMENTS: question %>
<%
  const letter = (i) => String.fromCharCode(64 + i);
  const usable = question && question.question !== '' && question.rating != null && question.answer && question.answer[0] !== '';
  const today = new Date().toISOString().split('T')[0];
  const attempts = usable ? question.stats.pass + question.stats.fail : 0;
%>
<p class="text-sm text-muted"><a class="link" href="/train">Train</a> / Daily problem</p>

<% if (!usable) { %>
  <h1 class="page-title mt-6">No daily problem today</h1>
  <p class="page-lead">The daily problem couldn't be loaded. If this keeps happening, tell an admin.</p>
  <a href="/train" class="btn btn-primary mt-6">Back to training</a>
<% } else { %>
  <h1 class="page-title mt-6">Daily problem</h1>
  <p class="page-lead"><%= today %> &middot; <%= question.subject[0] %> &middot; rated <%= question.rating %><% if (attempts > 0) { %> &middot; solved by <%= Math.round(100 * question.stats.pass / attempts) %>%<% } %></p>

  <% if (question.ext_source != 'original') { %>
  <p class="mt-2 text-sm text-muted">Source: <%= question.ext_source %><% if (question.source_statement) { %>. <%= question.source_statement %><% } %></p>
  <% } %>

  <div class="paper mt-8 max-w-3xl"><%- question.question %></div>

  <p class="mt-8 text-sm font-medium text-muted" id="daily-hint">
    <% if (question.type === 'sa') { %>Select every answer that applies.<% } else if (question.type === 'fr') { %>Type your answer.<% } else { %>Choose one answer.<% } %>
  </p>

  <form id="daily-form" class="mt-2" data-type="<%= question.type %>" data-answer="<%= question.answer.join('@') %>" onsubmit="return false">
    <% if (question.type === 'mc' || question.type === 'sa') { const multi = question.type === 'sa'; %>
    <div class="grid max-w-3xl gap-2" role="<%= multi ? 'group' : 'radiogroup' %>" aria-describedby="daily-hint">
      <% question.choices.forEach((choice, idx) => { %>
      <label class="choice">
        <input type="<%= multi ? 'checkbox' : 'radio' %>" name="pick" value="<%= idx + 1 %>">
        <span class="bubble"><%= letter(idx + 1) %></span>
        <span class="paper-sm"><%= choice %></span>
      </label>
      <% }) %>
    </div>
    <% } else if (question.type === 'fr') { %>
    <label class="sr-only" for="fr-answer">Your answer</label>
    <input type="text" id="fr-answer" name="pick" class="w-full max-w-md" autocomplete="off" placeholder="Your answer">
    <% } %>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button type="submit" class="btn btn-primary" id="submit">Check answer</button>
      <button type="button" class="btn btn-outline" id="give-up">Show the answer</button>
    </div>
  </form>

  <p id="verdict" class="mt-6 text-lg font-semibold" role="status" hidden></p>

  <section id="answer" class="rule-top mt-8" hidden>
    <h2 class="section-title">Answer</h2>
    <p class="mt-2" id="answer-line"></p>
    <h2 class="section-title mt-6">Explanation</h2>
    <div class="paper mt-3 max-w-3xl"><%- question.answer_ex %></div>
  </section>

  <script>
    (function () {
      var form = document.getElementById('daily-form');
      var type = form.getAttribute('data-type');
      var truth = form.getAttribute('data-answer').split('@');
      var verdict = document.getElementById('verdict');
      var answer = document.getElementById('answer');
      var line = document.getElementById('answer-line');
      var letters = function (list) { return list.map(function (n) { return String.fromCharCode(64 + parseInt(n, 10)); }).join(', '); };

      function reveal() {
        line.textContent = 'Correct answer: ' + (type === 'fr' ? truth[0] : letters(truth));
        answer.hidden = false;
        if (window.MathJax && MathJax.typesetPromise) MathJax.typesetPromise([answer]);
      }
      function mine() {
        var fields = form.querySelectorAll('[name="pick"]');
        if (type === 'fr') return [fields[0].value.trim()];
        return Array.prototype.filter.call(fields, function (f) { return f.checked; }).map(function (f) { return f.value; });
      }
      form.addEventListener('submit', function () {
        var got = mine();
        var ok = type === 'fr'
          ? got[0].toLowerCase() === truth[0].toLowerCase()
          : got.length === truth.length && got.slice().sort().join() === truth.slice().sort().join();
        verdict.hidden = false;
        verdict.className = 'mt-6 text-lg font-semibold ' + (ok ? 'pencil-good' : 'pen-weak');
        verdict.textContent = ok ? 'Correct' : 'Not yet. Try again, or show the answer.';
        if (ok) reveal();
      });
      document.getElementById('give-up').addEventListener('click', function () {
        verdict.hidden = true;
        reveal();
      });
    })();
  </script>

  <div class="mt-10 flex justify-end"><%- include('../../partials/app/contact.ejs', { questionId: question._id, redirect: '/train/daily', label: 'Report a problem' }) %></div>
<% } %>
