<%# Set the starting rating for a subject, rendered inside layouts/app.ejs %>
<%# ARGUMENTS: subject %>
<%
  const levels = [
    { name: 'Beginner', rating: 600, text: 'Middle-school level. Mostly conceptual questions, and simple calculations that apply one idea.' },
    { name: 'Intermediate', rating: 1200, text: 'Comfortable in an AP or IB course.' },
    { name: 'Advanced', rating: 2400, text: 'Ready for olympiad problems. Expect to be stretched.' },
  ];
%>
<p class="text-sm text-muted"><a class="link" href="/train">Train</a> / <%= subject %></p>
<h1 class="page-title mt-6">Where are you in <%= subject %>?</h1>
<p class="page-lead">This sets your starting rating. It adjusts after every answer, so a wrong guess here corrects itself within a few questions.</p>

<ul class="rows mt-10">
  <% levels.forEach((l) => { %>
  <li>
    <form action="/private/initialRating" method="POST">
      <input type="hidden" name="subject" value="<%= subject %>">
      <input type="hidden" name="level" value="<%= l.rating %>">
      <button type="submit" class="row-link w-full text-left" id="<%= l.name %>">
        <span class="grid gap-1 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8">
          <span>
            <span class="block text-xl font-semibold tracking-tight"><%= l.name %></span>
            <span class="block max-w-prose text-muted"><%= l.text %></span>
          </span>
          <span class="link">Start at <%= l.rating %></span>
        </span>
      </button>
    </form>
  </li>
  <% }) %>
</ul>
