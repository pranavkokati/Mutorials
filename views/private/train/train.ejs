<%# Training hub, rendered inside layouts/app.ejs %>
<%
  const modes = [
    { name: 'Classic training', href: '/train/chooseSubject', action: 'Choose a subject',
      text: 'Questions matched to your rating in Physics, Chemistry, Biology or Earth & Space Science. You pick the units, and every answer updates your rating.' },
    { name: 'Problem Rush', href: '/train/rush', action: 'Start a rush',
      text: 'A run of questions that get harder as you go. Your score is how far you get.' },
    { name: 'Daily problem', href: '/train/daily', action: 'Open today\'s problem',
      text: 'One hard problem, the same for everyone, refreshed at 00:00 UTC.' },
  ];
%>
<h1 class="page-title">Train</h1>
<p class="page-lead">Pick how you want to practise.</p>

<ul class="rows mt-10">
  <% modes.forEach((m) => { %>
  <li>
    <a class="row-link grid gap-1 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8" href="<%= m.href %>">
      <span>
        <span class="block text-xl font-semibold tracking-tight"><%= m.name %></span>
        <span class="mt-1 block max-w-prose text-muted"><%= m.text %></span>
      </span>
      <span class="link mt-2 sm:mt-0"><%= m.action %></span>
    </a>
  </li>
  <% }) %>
</ul>

<h2 class="section-title mt-14">Study smarter</h2>
<ul class="rows mt-4">
  <li>
    <a class="row-link" href="/coach">
      <span class="block font-semibold">Study coach</span>
      <span class="block max-w-prose text-muted">See which units you under- or over-perform in compared with your own rating, and get a suggested next unit.</span>
    </a>
  </li>
  <li>
    <a class="row-link" href="/review">
      <span class="block font-semibold">Spaced review</span>
      <span class="block max-w-prose text-muted">Questions you missed return on a schedule until you answer them correctly five times in a row. Review never changes your rating.</span>
    </a>
  </li>
</ul>
