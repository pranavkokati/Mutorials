<%# Training hub, rendered inside layouts/app.ejs %>

<h1 class="page-title">Train</h1>
<p class="page-lead">Three ways to practise. Classic and Rush update your rating; spaced review never does.</p>

<div class="mt-8 grid gap-4 md:grid-cols-3">
  <a class="card-link card-pad" href="/train/chooseSubject">
    <span class="badge badge-info">Rated</span>
    <h2 class="mt-3 text-xl font-bold">Classic training</h2>
    <p class="mt-1 text-sm muted">Adaptive questions matched to your rating in Physics, Chemistry, Biology or Earth &amp; Space Science. Choose the units you want.</p>
    <span class="btn btn-primary mt-4 w-fit">Start training</span>
  </a>
  <a class="card-link card-pad" href="/train/rush">
    <span class="badge badge-warn">Timed</span>
    <h2 class="mt-3 text-xl font-bold">Problem Rush</h2>
    <p class="mt-1 text-sm muted">A fast, increasingly difficult run of questions. Chase your high score.</p>
    <span class="btn btn-primary mt-4 w-fit">Start Rush</span>
  </a>
  <a class="card-link card-pad" href="/train/daily">
    <span class="badge">Daily</span>
    <h2 class="mt-3 text-xl font-bold">Daily question</h2>
    <p class="mt-1 text-sm muted">One new challenge problem every day, refreshed at 00:00 UTC.</p>
    <span class="btn btn-primary mt-4 w-fit">See today's challenge</span>
  </a>
</div>

<h2 class="mt-10 text-xl font-bold">Practise smarter</h2>
<div class="mt-3 grid gap-4 md:grid-cols-2">
  <a class="card-link card-pad" href="/coach">
    <h3 class="font-bold">Study coach</h3>
    <p class="mt-1 text-sm muted">See which units you under- or over-perform in relative to your own rating, and get a suggested next unit.</p>
  </a>
  <a class="card-link card-pad" href="/review">
    <h3 class="font-bold">Spaced review</h3>
    <p class="mt-1 text-sm muted">Revisit questions you missed on an increasing schedule until you get them right.</p>
  </a>
</div>
