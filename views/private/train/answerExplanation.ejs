<%# Result after answering, rendered inside layouts/app.ejs %>
<%# ARGUMENTS: correct, userRating, oldUserRating, oldQ, userAnswer, subject, units, user, newQues, experienceStats, passRate, attempts, spark %>
<%
  const letter = (i) => String.fromCharCode(64 + i);
  const key = String(subject).toLowerCase();
  const delta = userRating - oldUserRating;
  const mine = [].concat(userAnswer).map(String);
  const right = [].concat(newQues.answer).map(String);
  const next = '/train/' + subject + '/displayQuestion?units=' + units;
%>

<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
  <p class="text-sm text-muted"><a class="link" href="/train">Train</a> / <%= subject %></p>
  <%- include('../../partials/app/xp.ejs', { experienceStats }) %>
</div>

<header class="mt-8 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
  <div>
    <h1 class="page-title mb-3 <%= correct ? 'pencil-good' : 'pen-weak' %>"><%= correct ? 'Correct' : 'Not quite' %></h1>
    <p class="page-lead">
      Your <%= key %> rating is now <span class="font-semibold text-ink"><%= userRating %></span>
      (<%= delta >= 0 ? '+' + delta : '−' + Math.abs(delta) %>).
    </p>
  </div>
  <% if (spark) { %>
  <figure class="m-0">
    <svg viewBox="0 0 <%= spark.width %> <%= spark.height %>" width="<%= spark.width %>" height="<%= spark.height %>" role="img" aria-label="Your last <%= spark.samples %> <%= key %> ratings, <%= spark.change >= 0 ? 'up' : 'down' %> <%= Math.abs(Math.round(spark.change)) %> overall" class="max-w-full">
      <polyline points="<%= spark.points %>" fill="none" stroke="rgb(var(--ballpoint))" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
      <circle cx="<%= spark.last[0] %>" cy="<%= spark.last[1] %>" r="3.5" fill="rgb(var(--ballpoint))"/>
    </svg>
    <figcaption class="text-xs text-muted">Last <%= spark.samples %> answers</figcaption>
  </figure>
  <% } %>
</header>

<section class="rule-top mt-8" aria-labelledby="q-title">
  <h2 id="q-title" class="sr-only">The question</h2>
  <div class="paper max-w-3xl"><%- newQues.question %></div>

  <% if (newQues.type === 'mc' || newQues.type === 'sa') { %>
  <ul class="mt-6 grid max-w-3xl gap-2">
    <% newQues.choices.forEach((choice, idx) => { const n = String(idx + 1);
         const isRight = right.includes(n); const picked = mine.includes(n); %>
    <li class="choice-static <%= isRight ? 'choice-right' : (picked ? 'choice-wrong' : '') %>">
      <span class="bubble"><%= letter(idx + 1) %></span>
      <span class="paper-sm flex-1"><%= choice %></span>
      <% if (isRight && picked) { %><span class="text-sm font-semibold pencil-good">Your answer, correct</span>
      <% } else if (isRight) { %><span class="text-sm font-semibold pencil-good">Correct answer</span>
      <% } else if (picked) { %><span class="text-sm font-semibold text-redpen">Your answer</span><% } %>
    </li>
    <% }) %>
  </ul>
  <% } else if (newQues.type === 'fr') { %>
  <dl class="mt-6 grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2">
    <dt class="text-muted">You answered</dt><dd class="font-semibold <%= correct ? 'pencil-good' : 'text-redpen' %>"><%= mine.join(', ') %></dd>
    <dt class="text-muted">Correct answer</dt><dd class="font-semibold"><%= right.join(', ') %></dd>
  </dl>
  <% } %>
</section>

<section class="rule-top mt-10" aria-labelledby="ex-title">
  <h2 id="ex-title" class="section-title">Explanation</h2>
  <div class="paper mt-3 max-w-3xl"><%- newQues.answer_ex %></div>
  <% if (newQues.source_statement) { %><p class="mt-4 text-sm text-muted"><%= newQues.source_statement %></p><% } %>
</section>

<%- include('../../partials/app/tutor.ejs', { aiQuestionId: newQues._id, aiPhase: 'after', aiUserAnswer: userAnswer, aiCorrect: correct }) %>

<section class="rule-top mt-10" aria-labelledby="facts-title">
  <h2 id="facts-title" class="section-title">About this question</h2>
  <dl class="mt-3 grid max-w-xl grid-cols-[auto_1fr] gap-x-8 gap-y-2">
    <dt class="text-muted">Rating</dt><dd><%= oldQ %></dd>
    <dt class="text-muted">Solved by</dt>
    <dd><%= passRate === null ? 'No one yet' : passRate + '% of ' + attempts + ' attempts' %></dd>
    <% if (newQues.ext_source != 'original') { %><dt class="text-muted">Source</dt><dd><%= newQues.ext_source %></dd><% } %>
    <% if (newQues.tags && newQues.tags.length) { %>
    <dt class="text-muted">Tags</dt>
    <dd class="flex flex-wrap gap-1.5"><% newQues.tags.forEach((tag) => { %><span class="chip"><%= tag %></span><% }) %></dd>
    <% } %>
  </dl>
</section>

<div class="mt-10 flex flex-wrap items-center gap-3">
  <a class="btn btn-primary" href="<%= next %>" id="tryanother" <%= correct ? 'autofocus' : '' %>>Next question</a>
  <a class="btn btn-outline" href="/train" id="exit">Finish</a>
  <span class="flex-1"></span>
  <%- include('../../partials/app/contact.ejs', { questionId: newQues._id, redirect: next }) %>
</div>
