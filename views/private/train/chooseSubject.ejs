<%# Choose a subject to train on, rendered inside layouts/app.ejs %>
<%
  const choices = [
    { name: 'Physics', href: '/train/Physics/chooseUnits', color: '#0ea5e9', blurb: 'Mechanics, waves, optics, thermodynamics and modern physics.' },
    { name: 'Chemistry', href: '/train/Chemistry/chooseUnits', color: '#f59e0b', blurb: 'Stoichiometry, equilibria, kinetics, organic and more.' },
    { name: 'Biology', href: '/train/Biology/chooseUnits', color: '#22c55e', blurb: 'Cells, genetics, physiology, ecology and evolution.' },
    { name: 'Earth & Space Science', href: '/train/ESS/chooseUnits', color: '#a855f7', blurb: 'Tectonics, climate, astronomy and the solid Earth.' },
  ];
%>
<nav class="mb-4 text-sm muted" aria-label="Breadcrumb"><a class="underline hover:no-underline" href="/train">Train</a> / Classic</nav>
<h1 class="page-title">Choose a subject</h1>
<p class="page-lead">You will pick units on the next screen.</p>

<ul class="mt-8 grid gap-4 sm:grid-cols-2">
  <% choices.forEach((c) => { %>
  <li>
    <a class="card-link card-pad flex h-full flex-col" href="<%= c.href %>" style="border-left: 6px solid <%= c.color %>">
      <h2 class="text-xl font-bold"><%= c.name %></h2>
      <p class="mt-1 flex-1 text-sm muted"><%= c.blurb %></p>
      <span class="btn btn-primary mt-4 self-start">Choose units</span>
    </a>
  </li>
  <% }) %>
</ul>
