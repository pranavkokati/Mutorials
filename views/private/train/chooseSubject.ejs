<%# Choose a subject, rendered inside layouts/app.ejs %>
<%
  const choices = [
    { name: 'Physics', href: '/train/Physics/chooseUnits', color: '#3558f0', text: 'Mechanics, waves, optics, thermodynamics and modern physics.' },
    { name: 'Chemistry', href: '/train/Chemistry/chooseUnits', color: '#e8731c', text: 'Stoichiometry, equilibria, kinetics, organic chemistry and more.' },
    { name: 'Biology', href: '/train/Biology/chooseUnits', color: '#1fa06a', text: 'Cells, genetics, physiology, ecology and evolution.' },
    { name: 'Earth & Space Science', href: '/train/ESS/chooseUnits', color: '#9b5de5', text: 'Tectonics, climate, astronomy and the solid Earth.' },
  ];
%>
<p class="mb-6 text-sm muted"><a class="link" href="/train">Train</a> / Classic training</p>
<h1 class="page-title">Choose a subject</h1>
<p class="page-lead">You will choose units on the next screen.</p>

<ul class="rows mt-10">
  <% choices.forEach((c) => { %>
  <li>
    <a class="row-link grid grid-cols-[0.375rem_1fr_auto] items-center gap-x-5" href="<%= c.href %>">
      <span class="h-12 rounded-full" style="background: <%= c.color %>" aria-hidden="true"></span>
      <span>
        <span class="block text-xl font-semibold tracking-tight"><%= c.name %></span>
        <span class="block max-w-prose text-muted"><%= c.text %></span>
      </span>
      <span class="link hidden sm:block">Choose units</span>
    </a>
  </li>
  <% }) %>
</ul>
