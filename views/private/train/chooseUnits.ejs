<%# Choose units, rendered inside layouts/app.ejs %>
<%# ARGUMENTS: units - all units, subject, unitPresets - { name: [units] }, qNum %>
<p class="text-sm text-muted"><a class="link" href="/train">Train</a> / <a class="link" href="/train/chooseSubject">Classic training</a> / <%= subject %></p>
<h1 class="page-title mt-6"><%= subject %>: choose units</h1>
<p class="page-lead">Questions come only from the units you tick. Your choice is remembered for next time.</p>

<form action="/selQ" method="POST" class="mt-8" id="unit-form">
  <% const presets = Object.entries(unitPresets || {}); %>
  <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Quick selection">
    <button type="button" class="btn btn-outline" id="select-all">Select all</button>
    <button type="button" class="btn btn-outline" id="deselect-all">Clear</button>
    <% presets.forEach(([name, list]) => { %>
    <button type="button" class="btn btn-outline" data-preset="<%= JSON.stringify(list) %>"><%= name %></button>
    <% }) %>
  </div>

  <fieldset class="mt-6">
    <legend class="sr-only">Units</legend>
    <div class="grid gap-2 sm:grid-cols-2">
      <% units.forEach((unit) => { %>
      <label class="choice items-center">
        <input type="checkbox" name="unitChoice" class="unit-checkbox" id="<%= unit %>" value="<%= subject %> - <%= unit %>">
        <span class="bubble bubble-tick !mt-0" aria-hidden="true">&#10003;</span>
        <span><%= unit %></span>
      </label>
      <% }) %>
    </div>
  </fieldset>

  <input type="hidden" name="qNum" value="<%= qNum %>">
  <input type="hidden" name="subj" value="<%= subject %>">
  <div class="mt-8 flex flex-wrap items-center gap-3">
    <button type="submit" class="btn btn-primary" id="next">Start practising</button>
    <a class="btn btn-outline" href="/train/chooseSubject">Back</a>
    <p class="text-sm text-muted" id="unit-count" aria-live="polite"></p>
  </div>
</form>

<script>
  (function () {
    var KEY = 'mu-units-<%= subject %>';
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.unit-checkbox'));
    var count = document.getElementById('unit-count');

    function save() {
      var on = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.id; });
      try { localStorage.setItem(KEY, JSON.stringify(on)); } catch (e) {}
      count.textContent = on.length + ' of ' + boxes.length + ' units selected';
    }
    function setAll(value) { boxes.forEach(function (b) { b.checked = value; }); save(); }

    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || '[]');
      boxes.forEach(function (b) { b.checked = saved.indexOf(b.id) !== -1; });
    } catch (e) {}
    save();

    boxes.forEach(function (b) { b.addEventListener('change', save); });
    document.getElementById('select-all').addEventListener('click', function () { setAll(true); });
    document.getElementById('deselect-all').addEventListener('click', function () { setAll(false); });
    document.querySelectorAll('[data-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var list = JSON.parse(btn.getAttribute('data-preset'));
        boxes.forEach(function (b) { b.checked = list.indexOf(b.id) !== -1; });
        save();
      });
    });
    document.getElementById('unit-form').addEventListener('submit', function (e) {
      if (!boxes.some(function (b) { return b.checked; })) {
        e.preventDefault();
        count.textContent = 'Choose at least one unit.';
        count.classList.add('pen-weak');
      }
    });
  })();
</script>
