<%# Classic training question, rendered inside layouts/app.ejs %>
<%# ARGUMENTS: newQues, units, user, subject, experienceStats, referenceSheet, winChance, disabled (view-only) %>
<%
  const viewOnly = typeof disabled !== 'undefined' && disabled;
  const usable = newQues && newQues.question !== '' && newQues.rating != null && newQues.answer && newQues.answer[0] !== '';
  const unitQuery = Array.isArray(units) ? units.join(',') : units;
  const back = '/train/' + subject + '/displayQuestion?units=' + unitQuery;
  const letter = (i) => String.fromCharCode(64 + i);
  const userRating = user.rating[subject.toLowerCase()];
%>

<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
  <p class="text-sm text-muted"><a class="link" href="/train">Train</a> / <%= subject %></p>
  <%- include('../../partials/app/xp.ejs', { experienceStats }) %>
</div>

<% if (!usable) { %>
  <h1 class="page-title mt-8">This question can't be shown</h1>
  <p class="page-lead">Something is wrong with its text or answer key<% if (newQues) { %>. Please tell an admin that question <span class="font-mono"><%= newQues._id %></span> is broken<% } %>.</p>
  <a href="/train/<%= subject %>/chooseUnits" class="btn btn-primary mt-6">Choose different units</a>
<% } else { %>

  <% if (newQues.units && newQues.units.length) { %>
  <p class="mt-8 text-sm text-muted"><%= newQues.units.join(', ') %></p>
  <% } %>

  <% if (newQues.ext_source != 'original') { %>
  <p class="mt-1 text-sm text-muted">Source: <%= newQues.ext_source %><% if (newQues.source_statement) { %>. <%= newQues.source_statement %><% } %></p>
  <% } %>

  <form action="/train/checkAnswer" method="POST" class="mt-4">
    <h1 class="sr-only">Question</h1>
    <div class="paper max-w-3xl"><%- newQues.question %></div>

    <p class="mt-8 text-sm font-medium text-muted" id="answer-hint">
      <% if (newQues.type === 'sa') { %>Select every answer that applies.
      <% } else if (newQues.type === 'fr') { %>Type your answer.
      <% } else { %>Choose one answer.<% } %>
    </p>

    <% if (newQues.type === 'mc' || newQues.type === 'sa') { %>
      <% const multi = newQues.type === 'sa'; %>
      <div class="mt-2 grid max-w-3xl gap-2" role="<%= multi ? 'group' : 'radiogroup' %>" aria-describedby="answer-hint">
        <% newQues.choices.forEach((choice, idx) => { const n = idx + 1; %>
          <% if (viewOnly) { %>
          <div class="choice-static"><span class="bubble"><%= letter(n) %></span><span class="paper-sm"><%= choice %></span></div>
          <% } else { %>
          <label class="choice">
            <input type="<%= multi ? 'checkbox' : 'radio' %>" name="<%= multi ? 'saChoice' : 'answerChoice' %>" value="<%= n %>" <%= !multi && idx === 0 ? 'required' : '' %>>
            <span class="bubble"><%= letter(n) %></span>
            <span class="paper-sm"><%= choice %></span>
          </label>
          <% } %>
        <% }) %>
      </div>
    <% } else if (newQues.type === 'fr') { %>
      <% if (!viewOnly) { %>
      <label class="sr-only" for="fr-answer">Your answer</label>
      <input type="text" class="mt-2 w-full max-w-md" id="fr-answer" name="freeAnswer" autocomplete="off" required placeholder="Your answer">
      <% } %>
    <% } else { %>
      <p class="pen-weak mt-4">This question has an unknown type and can't be answered.</p>
    <% } %>

    <input type="hidden" name="id" value="<%= newQues._id %>">
    <input type="hidden" name="type" value="<%= newQues.type %>" id="hiddentypetag">
    <input type="hidden" name="subject" value="<%= subject %>">
    <input type="hidden" name="units" value="<%= unitQuery %>">
    <input type="hidden" name="redirect" value="<%= back %>">

    <% if (!viewOnly) { %>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <button class="btn btn-primary" type="submit" id="submit">Submit answer</button>
      <% if (winChance !== null && winChance !== undefined) { %>
      <p class="text-sm text-muted">Rated <%= newQues.rating %>. At your rating of <%= userRating %> you should get this right about <span class="font-semibold text-ink"><%= winChance %>%</span> of the time.</p>
      <% } %>
    </div>
    <% } %>
  </form>

  <% if (!viewOnly) { %>
    <%- include('../../partials/app/tutor.ejs', { aiQuestionId: newQues._id, aiPhase: 'before' }) %>
  <% } %>

  <% const sheets = Object.keys(referenceSheet).filter((s) => newQues.subject.includes(s)); %>
  <% if (sheets.length) { %>
  <section class="rule-top mt-10" aria-labelledby="ref-title">
    <h2 id="ref-title" class="section-title">Reference sheet</h2>
    <% ['Equations', 'Constants'].forEach((kind) => { %>
    <details class="ref border-b border-rule">
      <summary><%= kind %></summary>
      <dl class="grid gap-x-8 gap-y-3 pb-5 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
        <% sheets.forEach((s) => { Object.keys(referenceSheet[s][kind]).forEach((name) => { %>
        <dt class="font-medium"><%= name %></dt>
        <dd class="text-muted"><%= referenceSheet[s][kind][name] %></dd>
        <% }); }); %>
      </dl>
    </details>
    <% }) %>
  </section>
  <% } %>

  <% if (!viewOnly) { %>
  <section class="rule-top mt-10" aria-labelledby="skip-title">
    <h2 id="skip-title" class="section-title">Can't do this one yet?</h2>
    <details class="mt-2 max-w-prose">
      <summary class="btn-quiet -ml-3 cursor-pointer list-none">Skip this question</summary>
      <form action="/train/skipQuestion" method="POST" class="mt-3">
        <p class="text-muted">You get a different question, and your rating drops by 8.</p>
        <input type="hidden" name="id" value="<%= newQues._id %>">
        <input type="hidden" name="redirect" value="<%= back %>">
        <input type="hidden" name="subject" value="<%= subject %>">
        <button type="submit" class="btn btn-outline mt-3" id="yes-skip">Skip and lose 8 rating</button>
      </form>
    </details>
  </section>
  <% } %>

  <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
    <a class="link" href="/train/<%= subject %>/chooseUnits">Change units</a>
    <%- include('../../partials/app/contact.ejs', { questionId: newQues._id, redirect: back }) %>
  </div>
<% } %>
