<%# Spaced review queue, rendered inside layouts/app.ejs. ARGUMENTS: items, intervals %>
<h1 class="page-title">Spaced review</h1>
<p class="page-lead">
  Questions you missed return after <%= intervals.join(', ') %> days as you answer them correctly. Review never changes your rating.
</p>

<% if (items.length === 0) { %>
<p class="mt-10 max-w-prose">Nothing is due. Questions you miss will appear here when it is time to revisit them.</p>
<a class="btn btn-primary mt-4" href="/train">Go practise</a>
<% } else { %>
<p class="mt-10 text-sm text-muted"><span class="mark"><%= items.length %></span> due</p>
<ul class="rows mt-3">
  <% items.forEach((item) => { %>
  <li>
    <a class="row-link grid gap-1 sm:grid-cols-[1fr_auto] sm:gap-8" href="/review/<%= item.question %>">
      <span class="paper-sm line-clamp-2"><%= item.preview %></span>
      <span class="text-sm text-muted sm:text-right">
        <span class="font-medium text-ink"><%= item.subject.charAt(0).toUpperCase() + item.subject.slice(1) %></span><br>
        Step <%= item.box + 1 %> of <%= intervals.length %>, <%= item.overdueDays < 1 ? 'due now' : Math.floor(item.overdueDays) + (Math.floor(item.overdueDays) === 1 ? ' day overdue' : ' days overdue') %>
      </span>
    </a>
  </li>
  <% }) %>
</ul>
<% } %>
