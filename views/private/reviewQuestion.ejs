<%# One spaced-review question, rendered inside layouts/app.ejs. ARGUMENTS: question, entry, result (null before answering) %>
<p class="mb-6 text-sm muted"><a class="link" href="/review">Spaced review</a> / Question</p>
<p class="text-sm text-muted">Step <%= entry.box + 1 %> of 5. This does not affect your rating.</p>

<div class="paper mt-4 max-w-prose"><%- question.question %></div>

<% if (result === null) { %>
<form class="mt-8 max-w-prose" action="/review/<%= question._id %>" method="POST">
  <% if (question.type === 'mc' || question.type === 'sa') { %>
    <fieldset class="grid gap-3">
      <legend class="mb-3 text-sm text-muted"><%= question.type === 'mc' ? 'Choose one answer.' : 'Choose every answer that applies.' %></legend>
      <% question.choices.forEach((choice, i) => { %>
      <label class="choice" for="c<%= i + 1 %>">
        <input type="<%= question.type === 'mc' ? 'radio' : 'checkbox' %>" name="<%= question.type === 'mc' ? 'answerChoice' : 'saChoice' %>" id="c<%= i + 1 %>" value="<%= i + 1 %>">
        <span class="bubble" aria-hidden="true"><%= String.fromCharCode(65 + i) %></span>
        <span class="paper-sm pt-0.5"><span class="sr-only">Option <%= String.fromCharCode(65 + i) %>: </span><%= choice %></span>
      </label>
      <% }) %>
    </fieldset>
  <% } else { %>
    <label class="mb-2 block text-sm text-muted" for="freeAnswer">Your answer</label>
    <input id="freeAnswer" type="text" class="w-full" name="freeAnswer" autocomplete="off">
  <% } %>
  <button class="btn btn-primary mt-8" type="submit">Check answer</button>
</form>
<% } else { %>
<div class="mt-8 max-w-prose border-l-4 py-1 pl-5 <%= result.correct ? 'border-pencil' : 'border-redpen' %>" role="status">
  <p class="text-lg font-semibold <%= result.correct ? 'pencil-good' : 'pen-weak' %>"><%= result.correct ? 'Correct' : 'Not this time' %></p>
  <p class="mt-1">The answer is <span class="font-semibold"><%= result.correctAnswer %></span>.</p>
  <p class="mt-1 text-muted">
    <% if (result.graduated) { %>You have cleared this question, so it will not come back.
    <% } else { %>It returns in <%= result.nextInDays %> day<%= result.nextInDays === 1 ? '' : 's' %>.<% } %>
  </p>
</div>
<% if (question.answer_ex) { %>
<h2 class="section-title mt-10">Explanation</h2>
<div class="paper-sm mt-2 max-w-prose"><%- question.answer_ex %></div>
<% } %>
<a class="btn btn-primary mt-10" href="/review">Back to review</a>
<% } %>
