<%# One spaced-review question, rendered inside layouts/app.ejs. ARGUMENTS: question, entry, result (null before answering) %>

<nav class="mb-4 text-sm muted" aria-label="Breadcrumb"><a class="underline hover:no-underline" href="/review">Spaced review</a> / Question</nav>
<h1 class="page-title">Spaced Review</h1>
<p class="page-lead">Step <%= entry.box + 1 %> of 5. This does not affect your rating.</p>

<div class="card card-pad mt-6">
  <div class="prose-q"><%- question.question %></div>

  <% if (result === null) { %>
  <form class="mt-6" action="/review/<%= question._id %>" method="POST">
    <% if (question.type === 'mc' || question.type === 'sa') { %>
      <fieldset class="grid gap-2">
        <legend class="sr-only">Answer choices</legend>
        <% question.choices.forEach((choice, i) => { %>
        <label class="choice" for="c<%= i + 1 %>">
          <input type="<%= question.type === 'mc' ? 'radio' : 'checkbox' %>" name="<%= question.type === 'mc' ? 'answerChoice' : 'saChoice' %>" id="c<%= i + 1 %>" value="<%= i + 1 %>">
          <span><strong><%= String.fromCharCode(65 + i) %>.</strong> <%= choice %></span>
        </label>
        <% }) %>
      </fieldset>
    <% } else { %>
      <label class="sr-only" for="freeAnswer">Your answer</label>
      <input id="freeAnswer" type="text" class="w-full rounded-lg" name="freeAnswer" placeholder="Enter your answer" autocomplete="off">
    <% } %>
    <button class="btn btn-primary mt-6 w-fit" type="submit">Submit answer</button>
  </form>
  <% } else { %>
  <div class="mt-6 rounded-lg border px-4 py-3 <%= result.correct
    ? 'border-green-200 bg-green-50 text-green-900 dark:border-green-900 dark:bg-green-950 dark:text-green-200'
    : 'border-red-200 bg-red-50 text-red-900 dark:border-red-900 dark:bg-red-950 dark:text-red-200' %>" role="status">
    <p><strong><%= result.correct ? 'Correct.' : 'Not yet.' %></strong> Correct answer: <%= result.correctAnswer %></p>
    <p class="mt-1 text-sm">
      <% if (result.graduated) { %>You have cleared this question; it will not come back.
      <% } else { %>It will come back in <%= result.nextInDays %> day<%= result.nextInDays === 1 ? '' : 's' %>.<% } %>
    </p>
  </div>
  <% if (question.answer_ex) { %>
  <h2 class="mt-6 text-lg font-bold">Explanation</h2>
  <div class="mt-2"><%- question.answer_ex %></div>
  <% } %>
  <a class="btn btn-primary mt-6 w-fit" href="/review">Back to review</a>
  <% } %>
</div>
