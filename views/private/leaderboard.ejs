<%# Leaderboard, rendered inside layouts/app.ejs. ARGUMENTS: rankings (physics, chem, bio, usabo, rush, experience) %>
<%
  const boards = [
    { title: 'Physics', rows: rankings.physics.map((u) => [u.ign, u.rating.physics]), unit: 'Rating' },
    { title: 'Chemistry', rows: rankings.chem.map((u) => [u.ign, u.rating.chemistry]), unit: 'Rating' },
    { title: 'Biology', rows: rankings.bio.map((u) => [u.ign, u.rating.biology]), unit: 'Rating' },
    { title: 'USABO', rows: rankings.usabo.map((u) => [u.ign, u.rating.usabo]), unit: 'Rating' },
    { title: 'Problem Rush', rows: rankings.rush.map((u) => [u.ign, u.stats.rush.highscore]), unit: 'High score' },
    { title: 'Experience', rows: rankings.experience.map((u) => [u.ign, Math.round(u.experience), 'Lv ' + u.level.level]), unit: 'XP' },
  ];
  const medal = ['text-amber-500', 'text-neutral-400', 'text-orange-700'];
%>

<h1 class="page-title">Leaderboard</h1>
<p class="page-lead">Top trainers in each category.</p>

<div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
  <% boards.forEach((b) => { %>
  <section class="card card-pad" aria-labelledby="lb-<%= b.title.replace(/\s/g, '') %>">
    <h2 id="lb-<%= b.title.replace(/\s/g, '') %>" class="text-lg font-bold"><%= b.title %></h2>
    <% if (b.rows.length === 0) { %>
      <p class="mt-3 text-sm muted">No ranked trainers yet.</p>
    <% } else { %>
    <table class="mt-3 w-full text-sm">
      <caption class="sr-only"><%= b.title %> ranking</caption>
      <thead class="text-xs uppercase tracking-wide muted">
        <tr><th scope="col" class="w-10 pb-1 text-left">#</th><th scope="col" class="pb-1 text-left">Trainer</th><th scope="col" class="pb-1 text-right"><%= b.unit %></th></tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
        <% b.rows.forEach((row, i) => { %>
        <tr>
          <td class="py-2 font-bold tabular-nums <%= medal[i] || 'muted' %>"><%= i + 1 %></td>
          <td class="py-2"><a class="font-medium hover:underline" href="/profile/<%= encodeURIComponent(row[0]) %>"><%= row[0].length <= 18 ? row[0] : row[0].slice(0, 15) + '…' %></a><% if (row[2]) { %> <span class="text-xs muted"><%= row[2] %></span><% } %></td>
          <td class="py-2 text-right font-semibold tabular-nums"><%= row[1] %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>
  <% }) %>
</div>
