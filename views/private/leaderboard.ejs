<%# Leaderboard, rendered inside layouts/app.ejs. ARGUMENTS: rankings (physics, chem, bio, usabo, rush, experience) %>
<%
  const boards = [
    { title: 'Physics', rows: rankings.physics.map((u) => [u.ign, u.rating.physics]), unit: 'Rating' },
    { title: 'Chemistry', rows: rankings.chem.map((u) => [u.ign, u.rating.chemistry]), unit: 'Rating' },
    { title: 'Biology', rows: rankings.bio.map((u) => [u.ign, u.rating.biology]), unit: 'Rating' },
    { title: 'USABO', rows: rankings.usabo.map((u) => [u.ign, u.rating.usabo]), unit: 'Rating' },
    { title: 'Problem Rush', rows: rankings.rush.map((u) => [u.ign, u.stats.rush.highscore]), unit: 'High score' },
    { title: 'Experience', rows: rankings.experience.map((u) => [u.ign, Math.round(u.experience), 'Lv ' + u.level.level]), unit: 'XP' },
  ];
  
%>

<h1 class="page-title">Leaderboard</h1>
<p class="page-lead">The top ten in each category.</p>

<div class="mt-10 grid gap-x-14 gap-y-12 md:grid-cols-2">
  <% boards.forEach((b) => { %>
  <section aria-labelledby="lb-<%= b.title.replace(/\s/g, '') %>">
    <h2 id="lb-<%= b.title.replace(/\s/g, '') %>" class="section-title"><%= b.title %></h2>
    <% if (b.rows.length === 0) { %>
      <p class="mt-3 text-sm muted">Nobody is ranked here yet.</p>
    <% } else { %>
    <table class="plain mt-3 w-full text-sm">
      <caption class="sr-only"><%= b.title %> ranking</caption>
      <thead class="text-left text-muted">
        <tr class="border-b border-rule">
          <th scope="col" class="w-10 py-2 font-medium">Rank</th>
          <th scope="col" class="py-2 font-medium">Trainer</th>
          <th scope="col" class="py-2 text-right font-medium"><%= b.unit %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule">
        <% b.rows.forEach((row, i) => { %>
        <tr>
          <td class="py-2.5 tabular-nums <%= i === 0 ? 'font-semibold' : 'text-muted' %>"><% if (i === 0) { %><span class="mark"><%= i + 1 %></span><% } else { %><%= i + 1 %><% } %></td>
          <td class="py-2.5"><a class="font-medium hover:underline" href="/profile/<%= encodeURIComponent(row[0]) %>"><%= row[0].length <= 18 ? row[0] : row[0].slice(0, 15) + '…' %></a><% if (row[2]) { %> <span class="text-muted"><%= row[2] %></span><% } %></td>
          <td class="py-2.5 text-right font-semibold tabular-nums"><%= row[1] %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>
  <% }) %>
</div>
