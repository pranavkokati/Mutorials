<%#
  Signed-in navigation: a rail on large screens, a top bar with a menu on small ones.
  Uses locals: user, isAdmin, currentPath. All links are absolute.
%>
<% const path = locals.currentPath || '' %>
<% const here = (prefix) => (path === prefix || path.startsWith(prefix + '/')) ? 'aria-current="page"' : '' %>
<%
  const main = [
    ['Home', '/homepage'],
    ['Train', '/train'],
    ['Coach', '/coach'],
    ['Review', '/review'],
  ];
  const explore = [
    ['Leaderboard', '/leaderboard'],
    ['Search', '/search'],
    ['References', '/references'],
    ['Announcements', '/announcements'],
    ['USABO', '/usaboHomepage'],
  ];
  const account = [
    ['Profile', '/profile'],
    ['Statistics', '/stats'],
    ['Classes', '/class/dash'],
    ['Settings', '/settings'],
  ];
  if (locals.isAdmin) account.push(['Admin', '/admin/adminHomepage']);
%>

<%# Small screens: top bar %>
<header class="sticky top-0 z-30 border-b border-rule bg-sheet lg:hidden">
  <div class="flex h-14 items-center justify-between px-4">
    <a href="/homepage" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
      <img src="/images/icons/Icon_Main.png" width="24" height="24" alt="">Mutorials
    </a>
    <button type="button" class="btn-quiet" data-nav-toggle="mobile-nav" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-rule px-3 pb-4 pt-2" aria-label="Main">
    <% main.concat(explore).forEach(([label, href]) => { %>
      <a class="rail-link" href="<%= href %>" <%- here(href) %>><%= label %></a>
    <% }) %>
    <p class="rail-group">Account</p>
    <% account.forEach(([label, href]) => { %><a class="rail-small" href="<%= href %>"><%= label %></a><% }) %>
    <button type="button" class="rail-small w-full text-left" data-theme-toggle>Switch light or dark</button>
    <a class="rail-small" href="/logout">Log out</a>
  </nav>
</header>

<%# Large screens: rail %>
<aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col overflow-y-auto px-4 py-6 lg:flex">
  <a href="/homepage" class="mb-8 flex items-center gap-2 px-3 text-xl font-semibold tracking-tight">
    <img src="/images/icons/Icon_Main.png" width="28" height="28" alt="">Mutorials
  </a>
  <nav aria-label="Main">
    <% main.forEach(([label, href]) => { %>
      <a class="rail-link" href="<%= href %>" <%- here(href) %>><%= label %></a>
    <% }) %>
    <p class="rail-group">Explore</p>
    <% explore.forEach(([label, href]) => { %>
      <a class="rail-link" href="<%= href %>" <%- here(href) %>><%= label %></a>
    <% }) %>
  </nav>
  <div class="mt-auto pt-8">
    <p class="rail-group !mt-0 truncate"><%= locals.user ? locals.user.ign : '' %></p>
    <% account.forEach(([label, href]) => { %><a class="rail-small" href="<%= href %>"><%= label %></a><% }) %>
    <button type="button" class="rail-small w-full text-left" data-theme-toggle>Switch light or dark</button>
    <a class="rail-small" href="/logout">Log out</a>
  </div>
</aside>
