<%#
  Signed-in navigation. Uses locals: user, isAdmin, currentPath.
  All links are absolute so they work from any page depth.
%>
<% const path = locals.currentPath || '' %>
<% const current = (prefix) => (path === prefix || path.startsWith(prefix + '/')) ? 'aria-current="page"' : '' %>
<header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/90 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/90">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4 sm:px-6" aria-label="Main">
    <a href="/homepage" class="mr-2 flex items-center gap-2 font-bold">
      <img src="/images/icons/Icon_Main.png" width="26" height="26" alt="">
      <span class="hidden sm:inline">Mutorials</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      <a class="nav-link" href="/homepage" <%- current('/homepage') %>>Home</a>
      <a class="nav-link" href="/train" <%- current('/train') %>>Train</a>
      <a class="nav-link" href="/coach" <%- current('/coach') %>>Coach</a>
      <a class="nav-link" href="/review" <%- current('/review') %>>Review</a>
      <a class="nav-link" href="/leaderboard" <%- current('/leaderboard') %>>Leaderboard</a>
      <a class="nav-link" href="/search" <%- current('/search') %>>Search</a>
    </div>

    <div class="ml-auto flex items-center gap-1">
      <button type="button" class="btn-quiet px-2" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>

      <div class="relative">
        <button type="button" class="btn-quiet gap-1" data-menu-toggle="account-menu" aria-haspopup="true" aria-expanded="false">
          <span class="max-w-[8rem] truncate"><%= locals.user ? locals.user.ign : '' %></span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/></svg>
        </button>
        <div id="account-menu" data-menu class="menu-panel hidden" role="menu">
          <a href="/profile" role="menuitem">Profile</a>
          <a href="/stats" role="menuitem">Statistics</a>
          <a href="/class/dash" role="menuitem">Classes</a>
          <a href="/settings" role="menuitem">Settings</a>
          <% if (locals.isAdmin) { %><a href="/admin/adminHomepage" role="menuitem">Admin</a><% } %>
          <hr>
          <a href="/references" role="menuitem">References</a>
          <a href="/announcements" role="menuitem">Announcements</a>
          <a href="/usaboHomepage" role="menuitem">USABO</a>
          <hr>
          <a href="/logout" role="menuitem">Log out</a>
        </div>
      </div>

      <button type="button" class="btn-quiet px-2 md:hidden" data-nav-toggle="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" class="hidden border-t border-neutral-200 px-4 py-2 dark:border-neutral-800 md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col">
      <a class="nav-link" href="/homepage" <%- current('/homepage') %>>Home</a>
      <a class="nav-link" href="/train" <%- current('/train') %>>Train</a>
      <a class="nav-link" href="/coach" <%- current('/coach') %>>Coach</a>
      <a class="nav-link" href="/review" <%- current('/review') %>>Review</a>
      <a class="nav-link" href="/leaderboard" <%- current('/leaderboard') %>>Leaderboard</a>
      <a class="nav-link" href="/search" <%- current('/search') %>>Search</a>
    </div>
  </div>
</header>
