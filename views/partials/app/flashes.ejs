<%# Flash messages: a marked line at the top of the sheet. Errors in red pen, notices in highlighter. %>
<% const flashes = [] %>
<% const collect = (list, kind) => { (list || []).forEach((m) => flashes.push({ kind, text: m })) } %>
<% collect(locals.errorFlash, 'error') %>
<% collect(locals.successFlash, 'success') %>
<% if (flashes.length) { %>
  <div class="mb-8 grid gap-2" role="status" aria-live="polite">
    <% flashes.forEach((f) => { %>
      <p class="rounded-lg border-l-4 px-4 py-3 text-sm <%= f.kind === 'error' ? 'border-redpen bg-redpen/10' : 'border-pencil bg-pencil/10' %>"><%= f.text %></p>
    <% }) %>
  </div>
<% } %>
